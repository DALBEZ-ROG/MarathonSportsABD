# Copiar a .env y completar con valores reales

# --- Credencial de la APLICACION ---------------------------------------------
# usr_admin_marathon es un usuario SIN privilegios de superusuario: hereda
# rol_administrador (fase34_seguridad_roles.sql) y queda sujeto al modelo de
# privilegios. No usar postgres aqui: un superusuario ignora todos los GRANT y
# deja el modelo de seguridad sin efecto.
# La contrasena se asigna con:
#     ALTER ROLE usr_admin_marathon WITH PASSWORD '<clave>';
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mod_venta_inve
DB_USER=usr_admin_marathon
DB_PASSWORD=tu_password_aqui

JWT_SECRET=tu_secret_jwt_aqui

# --- Credenciales POR ROL (fase 37) ------------------------------------------
# El backend abre un pool de conexiones por rol y elige el pool segun el rol
# del usuario autenticado (RoleRoutingDataSource). Asi los seis roles de
# PostgreSQL entran en el camino de ejecucion: un operador de bodega llega a la
# base como usr_bodega_marathon, no como el administrador.
#
# El pool de arriba (DB_USER/DB_PASSWORD = usr_admin_marathon) sigue siendo el
# pool POR DEFECTO, y se usa cuando todavia no hay usuario autenticado: el
# login, el filtro JWT que resuelve el token, y el arranque de la aplicacion.
#
# Cada contrasena se asigna con:
#     ALTER ROLE usr_bodega_marathon WITH PASSWORD '<clave>';
# Nunca en un script versionado.
DB_USER_SUPERVISOR=usr_supervisor_marathon
DB_PASSWORD_SUPERVISOR=tu_password_aqui
DB_USER_BODEGA=usr_bodega_marathon
DB_PASSWORD_BODEGA=tu_password_aqui
DB_USER_PEDIDOS=usr_pedidos_marathon
DB_PASSWORD_PEDIDOS=tu_password_aqui
DB_USER_COMPRAS=usr_compras_marathon
DB_PASSWORD_COMPRAS=tu_password_aqui
DB_USER_PRODUCCION=usr_produccion_marathon
DB_PASSWORD_PRODUCCION=tu_password_aqui

# --- Credencial de los RESPALDOS ---------------------------------------------
# Separada a proposito. pg_basebackup exige el atributo REPLICATION, que
# usr_admin_marathon no tiene ni debe tener: concedérselo a la cuenta que
# atiende el trafico web permitiria a quien la comprometa clonar la base
# entera. La usan los scripts de scripts/backup.
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=tu_password_de_postgres_aqui
